#---------Plot Trajectory---------------#

plt.figure()
snapshots = 10
times = np.linspace(0,T,snapshots)

for t in times:
    q1t = q1(t)
    q2t = q2(t)
    q3t = q3(q1,q2, t)

    #Quadrotor body
    c3t = np.cos(q3t)
    s3t = np.sin(q3t)
    endpoints = np.array([
        [q1t - r * c3t, q2t - r * s3t],
        [q1t + r * c3t, q2t + r * s3t]])
    
    plt.scatter(q1t,q2t, c='b')
    plt.plot(*endpoints.T, c='b')

plt.title('Planar quadrotor trajectory')
plt.grid()
plt.savefig('planar_quad.png')

#-----Animation==========#
fig, ax = plt.subplots()
ax.set_xlim(-5, 5)  # adjust animation width to your trajectory
ax.set_ylim(-5, 5)
ax.set_aspect('equal')
ax.grid()

qr, = ax.plot([], [], lw=20)


def init():
    qr.set_data([], [])
    return qr,

def update(frame):
    q1t = q1(frame)
    q2t = q2(frame)
    q3t = q3(q1,q2,frame)
    c3t = np.cos(q3t)
    s3t = np.sin(q3t)
    endpoints = np.array([
        [q1t - r * c3t, q2t - r * s3t], #(x,y) back
        [q1t + r * c3t, q2t + r * s3t]]) #front
    qr.set_data([endpoints[0,0], endpoints[1,0]],
    [endpoints[0,1], endpoints[1,1]])
    return qr,

ani = FuncAnimation(fig, update, frames=tot_steps, init_func=init, blit=True)
ani.save("planar_quad.gif", writer="pillow", fps=1)
plt.close(fig)






